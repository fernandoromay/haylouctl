#!/usr/bin/env xdg-open
[Desktop Entry]
Version=1.0
Type=Application
Name=Haylou Control
Comment=Manage the Haylou desktop notification bridge
Comment[es]=Controla las notificaciones de Haylou
Exec=/home/fer/Código/haylou-notify/haylou-notify gui
Icon=preferences-system-notifications
Terminal=false
Categories=Utility;GTK;
StartupNotify=true
